{
  "mcpServers": {
    "engram": {
      "command": "${ENGRAM_BIN}",
      "args": ["mcp", "--tools=agent"]
    },
    "context7": {
      "serverUrl": "https://mcp.context7.com/mcp"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"],
      "env": {}
    },
    "context-mode": {
      "command": "context-mode",
      "args": ["--mcp"],
      "env": {}
    },
    "codegraph": {
      "command": "npx",
      "args": ["-y", "@colbymchenry/codegraph", "serve", "--mcp"],
      "env": {}
    }
  }
}
