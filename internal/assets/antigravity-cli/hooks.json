{
  "safety-gate": {
    "PreToolUse": [{
      "matcher": "run_command",
      "hooks": [{
        "type": "command",
        "command": "architect-ai hook cli-pretooluse",
        "timeout": 5
      }]
    }]
  },
  "context-routing": {
    "PreInvocation": [{
      "hooks": [{
        "type": "command",
        "command": "architect-ai hook cli-preinvocation",
        "timeout": 2
      }]
    }]
  },
  "sdd-stop": {
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "architect-ai hook cli-stop",
        "timeout": 3
      }]
    }]
  }
}
